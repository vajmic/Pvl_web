{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pvl-web",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}